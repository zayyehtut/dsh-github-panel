{
  "name": "dsh-github-panel",
  "version": "1.0.1",
  "private": true,
  "description": "GitHub panel for the DeepSeek Harness Web UI: connection status, repository dashboard, profile checklist and safe metadata actions in one page.",
  "license": "MIT",
  "author": "zayyehtut (https://github.com/zayyehtut)",
  "homepage": "https://github.com/zayyehtut/dsh-github-panel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zayyehtut/dsh-github-panel.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "github",
    "panel",
    "repository-management"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "screenshots.json",
    "assets/screenshot-*.png"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
